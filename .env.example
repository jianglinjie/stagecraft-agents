# Any OpenAI-compatible endpoint. Tests never read these.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna

# Reference search embeddings. Each defaults to the OPENAI_* value above. Not every chat
# endpoint serves /embeddings (DeepSeek does not): point these elsewhere, or set
# EMBEDDING_MODEL=none to run BM25 only without trying.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# STAGECRAFT_CORPUS_DIR=docs/corpus
